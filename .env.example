# Optional account login + sync (Supabase). Copy to .env.local (git-ignored) and fill in.
# Leave unset to build the app without any account features.
# The anon key is a public client key; Row Level Security (supabase/migrations/) protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
